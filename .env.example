VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# MCP bridge (server-only; never expose these with VITE_). Provider keys are entered by MasterAdmin in the Admin page.
MCP_SERVER_TOKEN=
MCP_SCOPE_SECRET=
MCP_PUBLIC_URL=

# Cloud Run only. Create this queue and grant its runtime service account
# roles/cloudtasks.enqueuer before deploying; local development uses a local worker.
MCP_TASK_QUEUE=

# Cloud Run can provide these automatically, but keeping them explicit helps local setup.
GOOGLE_CLOUD_PROJECT=
FIREBASE_STORAGE_BUCKET=

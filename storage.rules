rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/snapshots/{snapshotId}/{filePath=**} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow read: if owner();
      allow create: if owner() && request.resource.size <= 50 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
